[Unit]
Description=AIOS Event Daemon - routes events to AI pins
After=redis-server.service network.target aios-executor-supervisor.service
Wants=redis-server.service

[Service]
Type=simple
User=aios
WorkingDirectory=${AIOS_HOME}/kernel/tools
ExecStart=${HOME}/.local/share/uv/python/cpython-3.11.15-linux-x86_64-gnu/bin/python3 ${AIOS_HOME}/kernel/tools/aios_event_daemon.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
