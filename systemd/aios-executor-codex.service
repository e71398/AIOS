[Unit]
Description=AIOS Executor - Codex code and batch specialist
After=network-online.target aios-entry-gateway.service aios-codex-relay.service
Wants=aios-codex-relay.service

[Service]
Type=simple
WorkingDirectory=${AIOS_HOME}
ExecStart=/usr/bin/python3 ${AIOS_HOME}/kernel/tools/aios_executor_daemon.py codex
Restart=on-failure
RestartSec=5
EnvironmentFile=-${HOME}/.openclaw/.env
Environment=PATH=${HOME}/.n/bin:${HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=AIOS_HOME=${AIOS_HOME}
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=aios-core.target
